{
  "name": "agent-mcp-manager",
  "version": "0.1.0",
  "description": "Programmatic add/link/unlink for MCP servers across 23 AI coding agents (Claude Code, Claude Desktop, Cursor, VS Code, Codex, Gemini CLI, Zed, Cline, OpenCode, Goose, Kiro, Windsurf, and more). Functional API with dry-run support.",
  "license": "MIT",
  "author": "Dani Akash",
  "homepage": "https://github.com/DaniAkash/agent-toolkit/tree/main/packages/agent-mcp-manager#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DaniAkash/agent-toolkit.git",
    "directory": "packages/agent-mcp-manager"
  },
  "bugs": "https://github.com/DaniAkash/agent-toolkit/issues",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "mcp-server",
    "mcp-installer",
    "claude-code",
    "claude-desktop",
    "cursor",
    "vscode",
    "codex",
    "gemini",
    "zed"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./lowlevel": {
      "types": "./dist/lowlevel.d.ts",
      "import": "./dist/lowlevel.js"
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "scripts": {
    "build": "bunup",
    "dev": "bunup --watch",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@iarna/toml": "^2.2.5",
    "jsonc-parser": "^3.3.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "bunup": "^0.16.32",
    "typescript": "^6.0.3"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
